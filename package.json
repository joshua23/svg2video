    "@react-three/fiber": "^8.17.14",
    "@remotion/bundler": "^4.0.357",
    "@remotion/cli": "^4.0.357",
    "@remotion/paths": "^4.0.357",
    "@remotion/player": "^4.0.357",
    "@remotion/renderer": "^4.0.357",
    "@remotion/three": "^4.0.357",
    "@supabase/supabase-js": "^2.57.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.1",
    "@types/three": "^0.170.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.344.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.357",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
